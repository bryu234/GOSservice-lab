COMPOSE_PROJECT_NAME=gosservice_lab

# Host access ports. Change these values when local ports are busy.
ADM_RDP_HOST_PORT=43389
ADM_SSH_HOST_PORT=2222
USER_RDP_HOST_PORT=43390
USER_SSH_HOST_PORT=2223
EVIL_RDP_HOST_PORT=43391
EVIL_SSH_HOST_PORT=2224
WEBSITE_HTTP_HOST_PORT=8088
WAZUH_DASHBOARD_HOST_PORT=8443

# Demo lab credentials. Copy this file to .env and change passwords before non-training use.
LOCALADMIN_USER=admin
LOCALADMIN_PASSWORD=xxXX1234!
USER_USERNAME=user
USER_PASSWORD=xxXX1234!
EVIL_USERNAME=evil
EVIL_PASSWORD=xxXX1234!
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=xxXX1234!

# DNS and internal lab addressing.
GOS_DOMAIN=gos.local
GOS_INTERNAL_SUBNET=10.10.20.0/24
GOS_EXTERNAL_SUBNET=172.28.8.0/24

GOS_ARM_ADM_IP=10.10.20.10
GOS_ARM_USER_IP=10.10.20.11
GOS_ARM_EVIL_IP=172.28.8.10
GOS_ROUTER_INTERNAL_IP=10.10.20.254
GOS_ROUTER_EXTERNAL_IP=172.28.8.254
GOS_DNS_IP=10.10.20.53
GOS_WEB_INTERNAL_IP=10.10.20.20
GOS_DB_IP=10.10.20.30
GOS_MAIL_IP=10.10.20.40
GOS_WAZUH_MANAGER_IP=10.10.20.50
GOS_WAZUH_INDEXER_IP=10.10.20.51
GOS_WAZUH_DASHBOARD_IP=10.10.20.52

# Internal lab mail.
MAIL_DOMAIN=gos.local
MAIL_HOSTNAME=mail.gos.local
MAIL_USER=user
MAIL_PASSWORD=xxXX1234!

# Wazuh full SIEM stack. These complex demo passwords match the tracked bcrypt
# hashes and dashboard API config. Keep the three files synchronized if changed.
WAZUH_VERSION=4.14.0
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=GosIndexer2026!
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=GosDashboard2026!
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=GosApi2026!Secure

# EspoCRM database.
NGINX_VERSION=1.30.0
ESPOCRM_VERSION=10.0.1
ESPOCRM_DB_NAME=espocrm
ESPOCRM_DB_USER=espocrm
ESPOCRM_DB_PASSWORD=xxXX1234!
ESPOCRM_DB_ROOT_PASSWORD=xxXX1234!
